# Copy to backend/.env for local development. Never commit the real .env.
# In production (Render) these are set in the service's environment instead;
# see render.yaml.

# --- Database: either DATABASE_URL, or the DB_* variables -------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/assessly
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assessly

# --- Auth (required) ---------------------------------------------------------
# At least 32 random characters; the server refuses to start otherwise.
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login lasts (jsonwebtoken format). Default 7d.
# JWT_EXPIRES_IN=7d

# --- OMR engine ----------------------------------------------------------------
# Python interpreter with requirements.txt installed. Optional on Windows when
# omr/.venv exists; otherwise defaults to python3 / python on PATH.
# OMR_PYTHON=omr/.venv/bin/python

# --- Password reset email (needed for "Forgot password") -------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Assessly <no-reply@example.com>

# --- Google sign-in (optional) ---------------------------------------------------
# The *Web* OAuth client ID; the app must be built with the same value as
# GOOGLE_WEB_CLIENT_ID.
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com

# --- Metrics (optional) -------------------------------------------------------------
# /metrics answers only with "Authorization: Bearer <METRICS_TOKEN>".
# METRICS_TOKEN=

# PORT=5000
# NODE_ENV=production   # enables TLS to the database
